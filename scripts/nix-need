#!/usr/bin/env -S nu --no-std-lib

def main (
  --profile: string
  ...pkgs: string
) {
  let installed = ^nix profile list --json --profile $profile | from json | get elements | columns
  let pkgs = $pkgs | where $it not-in $installed
  let pkgs = $pkgs | to json --raw | str replace --all "," " "
  if ($pkgs | is-empty) { return }
  ^nix eval --raw -I nixpkgs=channel:nixpkgs-unstable --impure --expr (r#'
    let
      pkgs = import <nixpkgs> {};
      inherit (pkgs.lib) attrByPath splitString;
    in with builtins;
      concatStringsSep "\n"
        (sort (a: b: a < b)
              (filter (name: attrByPath (splitString "." name) null pkgs != null)'# +
                        $pkgs + '))')
}
